{
  "manifest_version": 3,
  "name": "Steal Book — 훔치기",
  "short_name": "Steal Book",
  "version": "1.0.0",
  "description": "웹에서 이미지·링크·페이지·글을 오른쪽 클릭 한 번으로 Steal Book에 담습니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "이 페이지 Steal Book에 담기 (Alt+Shift+S)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "activeTab"],
  "host_permissions": ["https://steal-book.vercel.app/*"],
  "commands": {
    "steal-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "지금 페이지 담기"
    }
  }
}
